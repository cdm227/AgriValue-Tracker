# Azure Key Vault (optional)
KEYVAULT_NAME=your-keyvault-name

# Foundry IQ — Azure AI Foundry Responses API (preferred, matches Azure AI Foundry samples)
FOUNDRY_OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# Foundry IQ — Project agent Responses endpoint (also supported)
FOUNDRY_RESPONSES_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project/agents/your-agent/endpoint/protocols/openai/responses
# Optional. If omitted, server uses DefaultAzureCredential / managed identity.
FOUNDRY_API_KEY=your-foundry-project-key

# Legacy Azure OpenAI Assistants-compatible path (fallback)
AZURE_AI_AGENT_ID=asst_xxxxxxxxxxxxxxxx
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here

# Fabric IQ — Microsoft Fabric Lakehouse SQL (optional)
FABRIC_SQL_SERVER=your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=AgriValueLakehouse
# SQL auth (optional — omit to use Azure AD via DefaultAzureCredential)
# FABRIC_SQL_USER=
# FABRIC_SQL_PASSWORD=

# Work IQ — Microsoft Graph Teams notifications (optional)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_CLIENT_SECRET=your-client-secret
TEAMS_TEAM_ID=your-team-id
TEAMS_CHANNEL_ID=your-channel-id
# Simpler alternative: Incoming Webhook URL
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# CORS — GitHub Pages origin
CORS_ORIGINS=https://cdm227.github.io,http://localhost:3000

# Server
PORT=3000
